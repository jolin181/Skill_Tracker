# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skill_leveling_db

# Connections per API process = DB_POOL_SIZE + DB_MAX_OVERFLOW
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# ── Security ──────────────────────────────────────────────────────────────────
# Signs access tokens. Must be random and at least 32 characters; the app refuses to start otherwise.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# Refresh-token cookie. Local development runs over http; in production (https) set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Brute-force protection: lock an account for a while after too many wrong passwords.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
ALLOW_STUDENT_SELF_REGISTRATION=true
# Password hashes computed at once per process (each needs ~64 MB RAM).
PASSWORD_HASH_WORKERS=4

# ── Secret Code Encryption ────────────────────────────────────────────────────
# Fernet key (32-byte base64-encoded). Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CODE_ENCRYPTION_KEY=change-me-to-a-fernet-key

# ── LLM / AI Engine ───────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
